<div data-controller="local-time">
<div class="container mt-4">
  <h1 class="mb-4">Attendance History</h1>

  <% @attendances.each do |attendance| %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">

        <h4 class="mb-3">
          <%= attendance.work_date.strftime("%Y-%m-%d") %>
        </h4>

        <!-- Attendance Summary -->
        <div class="table-responsive">
          <table class="table table-bordered">
            <thead class="table-light">
              <tr>
                <th>Sign In</th>
                <th>Sign Off</th>
                <th>Working Hours</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>
                  <% if attendance.signed_in_at %>
                      <%= attendance.signed_in_at.strftime("%I:%M:%p") %>
                  <% else %>
                    -
                  <% end %>


                </td>

                <td>
                  <%= attendance.signed_off_at&.strftime("%I:%M %p") || "-" %>
                </td>

                <td>
                  <%= attendance.formatted_worked_time %>
                </td>

                <td>
                  <%= attendance.status.humanize %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Break Details -->
        <h5 class="mt-4 mb-3">Break Details</h5>

        <div class="table-responsive">
          <table class="table table-sm table-striped table-bordered">
            <thead class="table-light">
              <tr>
                <th>Break Start</th>
                <th>Break End</th>
                <th>Break Duration</th>
              </tr>
            </thead>

            <tbody>
              <% attendance.break_periods.order(:started_at).each do |break_period| %>
                <tr>
                  <td>
                    <%= break_period.started_at.strftime("%I:%M:%S %p") %>
                  </td>

                  <td>
                    <%= break_period.ended_at&.strftime("%I:%M:%S %p") || "-" %>
                  </td>

                  <td>
                    <%= break_period.formatted_duration %>
                  </td>
                </tr>
              <% end %>

              <% if attendance.break_periods.empty? %>
                <tr>
                  <td colspan="3" class="text-center text-muted">
                    No breaks recorded
                  </td>
                </tr>
              <% end %>
            </tbody>

            <tfoot>
              <tr class="table-light">
                <th colspan="2" class="text-end">
                  Total Break Time
                </th>
                <th>
                  <%= attendance.formatted_break_time %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>

      </div>
    </div>
  <% end %>

  <%= link_to "Back to Dashboard", root_path,
      class: "btn btn-outline-primary" %>
</div>
</div>